{
  "$schema": "./agent-variant.schema.json",
  "vendor": "commandcode",
  "destDir": ".commandcode/agents",
  "modelDefault": "inherit",
  "maxTurnsDefault": 100,
  "toolsDefault": [
    "read_file",
    "write_file",
    "edit_file",
    "shell_command",
    "grep",
    "glob"
  ],
  "protocolPath": ".agents/skills/_shared/runtime/execution-protocols/commandcode.md",
  "agents": {
    "architecture-reviewer": {
      "tools": [
        "read_file",
        "write_file",
        "edit_file",
        "shell_command",
        "grep",
        "glob"
      ]
    },
    "tf-infra-engineer": {
      "tools": [
        "read_file",
        "write_file",
        "edit_file",
        "shell_command",
        "grep",
        "glob"
      ]
    },
    "pm-planner": {
      "tools": ["read_file", "write_file", "grep", "glob", "shell_command"]
    },
    "qa-reviewer": {
      "tools": ["read_file", "grep", "glob", "shell_command"]
    },
    "docs-curator": {
      "tools": [
        "read_file",
        "write_file",
        "edit_file",
        "shell_command",
        "grep",
        "glob"
      ]
    },
    "research-explorer": {
      "tools": [
        "read_file",
        "write_file",
        "edit_file",
        "shell_command",
        "grep",
        "glob",
        "web_search",
        "web_fetch"
      ]
    }
  }
}
