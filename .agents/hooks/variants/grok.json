{
  "$schema": "./hook-variant.schema.json",
  "vendor": "grok",
  "hookDir": ".grok/hooks",
  "settingsFile": ".grok/hooks/oma-hooks.json",
  "projectDirEnv": "GROK_WORKSPACE_ROOT",
  "runtime": "bun",
  "events": {
    "UserPromptSubmit": [
      {
        "hook": "keyword-detector.ts",
        "timeout": 5
      },
      {
        "hook": "state-boundary.ts",
        "timeout": 5
      },
      {
        "hook": "skill-injector.ts",
        "timeout": 3
      },
      {
        "hook": "serena-primer.ts",
        "timeout": 3
      }
    ],
    "PreToolUse": [
      {
        "hook": "scm-guard.ts",
        "matcher": "Bash",
        "timeout": 3
      },
      {
        "hook": "test-filter.ts",
        "matcher": "Bash",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "hook": "refactor-guard.ts",
        "matcher": "hashline_edit|apply_patch|create_file|write_file|edit_file|str_replace",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "hook": "persistent-mode.ts",
        "timeout": 5
      },
      {
        "hook": "refactor-guard.ts",
        "timeout": 5
      }
    ]
  }
}
