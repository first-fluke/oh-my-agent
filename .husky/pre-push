# Git exports repository-local variables in hooks. Tests create their own
# repositories; inheriting these variables redirects their Git operations here.
for oma_git_env in $(git rev-parse --local-env-vars); do
  unset "$oma_git_env"
done

bun run typecheck
# Mirror GitHub Actions, which sets CI=true automatically. Catches tests
# that behave differently under non-interactive yes-mode (install.ts).
CI=true bun run test
# Same gate CI runs on ubuntu. Without it, edits under .agents/ that change the
# emitted marketplace manifest or cli/{CLAUDE,AGENTS}.md only surface after the
# push has already landed on main.
bun run --cwd cli check:emit-drift
