# Default: treat all text files as text and force LF on checkout
# so Windows runners don't get CRLF (which Biome flags as a format error).
* text=auto eol=lf

# Shell scripts must stay LF regardless of platform.
*.sh text eol=lf
*.bash text eol=lf

# PowerShell scripts use CRLF natively; preserve as-is.
*.ps1 text eol=crlf

# Keep the emitted plugin packages that hosts only ever git-clone or install
# from a local path out of the GitHub archive. Anthropic's plugin directory
# validates that archive (50 MiB / 10,000 entries); cli/scripts/
# check-repo-archive.mjs gates the same tar. Clones and local paths are
# unaffected. codex-plugin/ stays: Codex marketplace installs resolve it.
pi-package/ export-ignore
antigravity-plugin/ export-ignore
commandcode-mod/ export-ignore

# Mark common binaries so they aren't touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
