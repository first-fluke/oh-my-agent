# Default: treat all text files as text and force LF on checkout
# so Windows runners don't get CRLF (which Biome flags as a format error).
* text=auto eol=lf

# Shell scripts must stay LF regardless of platform.
*.sh text eol=lf
*.bash text eol=lf

# PowerShell scripts use CRLF natively; preserve as-is.
*.ps1 text eol=crlf

# Anthropic's plugin directory validates the GitHub archive of the whole
# repository (50 MiB / 10,000 entries); cli/scripts/check-repo-archive.mjs
# gates the same tar. The emitted plugin packages that hosts install from a
# local path (codex-plugin/, pi-package/, antigravity-plugin/,
# commandcode-mod/) are not committed at all, so no export-ignore is needed.

# Mark common binaries so they aren't touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
